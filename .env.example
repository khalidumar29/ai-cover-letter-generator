# Copy to .env and fill in real values.

DATABASE_URL="file:./dev.db"

# Signing key for session JWTs. Rotating it logs everyone out.
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="no-reply@yourdomain.com"
BREVO_SENDER_NAME="AI Cover Letter Generator"

# Base URL used to build verification and reset links inside emails.
APP_URL="http://localhost:3000"

# DeepSeek, used for cover letter generation and inline rewrites.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# Stripe (https://dashboard.stripe.com/apikeys). A restricted key (rk_...) with
# write access to Checkout Sessions is preferred over a full secret key.
STRIPE_SECRET_KEY="rk_test_..."
# Signing secret of the webhook endpoint pointing at /api/payments/webhook.
# Locally, `stripe listen --forward-to localhost:3000/api/payments/webhook` prints one.
STRIPE_WEBHOOK_SECRET="whsec_..."
